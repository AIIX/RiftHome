// Sharp windows from a window's full-size image (the window pass's output), in linear light (sRGB or PQ
// values decoded first and encoded again after). The runtime samples its layers bilinearly from one mip level only.
// - Smaller (mode 0), for a window shown with fewer pixels than it has (else text shimmers as the head moves): each
//   pixel averages N x N bilinear taps spread over its footprint; one more row and column repeat the edge, so the
//   runtime's sampling at the shown part's border never reaches the stale pixels beyond it.
// - Twice as big (mode 1), for a window shown bigger than the runtime's 1:1 density (its bilinear enlarging blurs it):
//   Lanczos-2, its overshoot kept within the colour's range.
// OUTPUT_FLOAT: 16-bit float images, else 8-bit ones (sRGB values: the runtime decodes them).

layout(local_size_x = 16, local_size_y = 16) in;

#ifdef OUTPUT_FLOAT
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D master;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;
#else
layout(set = 0, binding = 0, rgba8) uniform readonly image2D master;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#endif

layout(push_constant) uniform Params {
    ivec2 masterSize; // the full-size image's pixels
    ivec2 shownSize; // the copy's pixels
    uint encoding; // 0: linear values, 1: sRGB, 2: PQ (the runtime decodes PQ without the alpha, as here)
    uint mode; // 0: smaller, area filter; 1: twice as big, Lanczos-2
} p;

vec3 srgbToLinear(vec3 c)
{
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

vec3 linearToSrgb(vec3 c)
{
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
}

const float m1 = 2610.0 / 16384.0;
const float m2 = 2523.0 / 4096.0 * 128.0;
const float c1 = 3424.0 / 4096.0;
const float c2 = 2413.0 / 4096.0 * 32.0;
const float c3 = 2392.0 / 4096.0 * 32.0;

vec3 pqToLinear(vec3 e)
{
    const vec3 x = pow(clamp(e, 0.0, 1.0), vec3(1.0 / m2));
    return pow(max(x - c1, 0.0) / (c2 - c3 * x), vec3(1.0 / m1));
}

vec3 linearToPq(vec3 y)
{
    const vec3 x = pow(clamp(y, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * x) / (1.0 + c3 * x), vec3(m2));
}

// Premultiplied alpha in and out. sRGB: per channel, as the runtime's sRGB views decode them; PQ: without the alpha.
vec4 toLinear(vec4 c)
{
    if (p.encoding == 1u) {
        return vec4(srgbToLinear(c.rgb), c.a);
    }
    if (p.encoding == 2u) {
        return c.a > 0.0 ? vec4(pqToLinear(c.rgb / c.a) * c.a, c.a) : vec4(0.0);
    }
    return c;
}

vec4 fromLinear(vec4 c)
{
    if (p.encoding == 1u) {
        return vec4(linearToSrgb(c.rgb), c.a);
    }
    if (p.encoding == 2u) {
        return c.a > 0.0 ? vec4(linearToPq(c.rgb / c.a) * c.a, c.a) : vec4(0.0);
    }
    return c;
}

vec4 texel(ivec2 xy)
{
    return toLinear(imageLoad(master, clamp(xy, ivec2(0), p.masterSize - 1)));
}

// Bilinear at @p pos in the full-size image's pixels (texel centres at i + 0.5), edges clamped.
vec4 bilinear(vec2 pos)
{
    const vec2 q = pos - 0.5;
    const ivec2 i = ivec2(floor(q));
    const vec2 t = q - vec2(i);
    return mix(mix(texel(i), texel(i + ivec2(1, 0)), t.x), mix(texel(i + ivec2(0, 1)), texel(i + ivec2(1, 1)), t.x), t.y);
}

float lanczos2(float x)
{
    x = abs(x);
    if (x < 1e-5) {
        return 1.0;
    }
    if (x >= 2.0) {
        return 0.0;
    }
    const float pi = 3.14159265;
    return 2.0 * sin(pi * x) * sin(pi * x / 2.0) / (pi * pi * x * x);
}

// Twice as big: output pixel o sits at (o + 0.5) / 2 - 0.5 in the full-size image's texel centres; 4 x 4 taps.
void enlarge(ivec2 xy)
{
    const vec2 c = (vec2(xy) + 0.5) / 2.0 - 0.5;
    const ivec2 base = ivec2(floor(c)) - 1;
    vec4 wx, wy;
    for (int i = 0; i < 4; ++i) {
        wx[i] = lanczos2(c.x - float(base.x + i));
        wy[i] = lanczos2(c.y - float(base.y + i));
    }
    wx /= dot(wx, vec4(1.0));
    wy /= dot(wy, vec4(1.0));
    vec4 sum = vec4(0.0);
    for (int j = 0; j < 4; ++j) {
        vec4 row = vec4(0.0);
        for (int i = 0; i < 4; ++i) {
            row += wx[i] * texel(base + ivec2(i, j));
        }
        sum += wy[j] * row;
    }
    sum.a = clamp(sum.a, 0.0, 1.0);
    sum.rgb = clamp(sum.rgb, vec3(0.0), vec3(p.encoding == 0u ? 65504.0 : sum.a)); // premultiplied: no more than its alpha
    imageStore(target, xy, fromLinear(sum));
}

void main()
{
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (p.mode == 1u) {
        if (all(lessThan(xy, p.shownSize)) && all(lessThan(xy, imageSize(target)))) {
            enlarge(xy);
        }
        return;
    }
    if (any(greaterThan(xy, p.shownSize)) || any(greaterThanEqual(xy, imageSize(target)))) {
        return;
    }
    const ivec2 c = min(xy, p.shownSize - 1); // the extra row and column repeat the edge
    const vec2 ratio = vec2(p.masterSize) / vec2(p.shownSize);
    const ivec2 n = ivec2(ceil(ratio - 0.001));
    vec4 sum = vec4(0.0);
    for (int ty = 0; ty < n.y; ++ty) {
        for (int tx = 0; tx < n.x; ++tx) {
            sum += bilinear((vec2(c) + (vec2(tx, ty) + 0.5) / vec2(n)) * ratio);
        }
    }
    imageStore(target, xy, fromLinear(sum / float(n.x * n.y)));
}
