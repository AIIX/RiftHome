[Desktop Entry]
# Installed by the package into /etc/xdg/autostart: at desktop login, before the user's own Firefox starts, Rift Home's
# Firefox preferences leave the user's own profile if Rift Home ended (a crash, a power cut) without taking them out.
Type=Application
Name=Rift Home: Firefox profiles back
Comment=Takes Rift Home's Firefox preferences out of the user's own profile after an unexpected end
Exec=rift-home --restore-firefox-profiles
NoDisplay=true
Terminal=false
X-KDE-autostart-phase=0
X-GNOME-Autostart-Phase=Initialization
